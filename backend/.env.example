# Server Configuration
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# Database Connection (Leave empty to use automatic in-memory zero-config DB for instant demo, or provide your MongoDB Atlas / Local URI)
MONGODB_URI=mongodb://127.0.0.1:27017/stocksphere

# JWT Authentication
JWT_SECRET=stocksphere_super_secret_jwt_key_2025_secure_random
JWT_EXPIRE=7d

# Razorpay Configuration (Provide test keys or keep demo mode enabled)
RAZORPAY_KEY_ID=rzp_test_placeholder_key
RAZORPAY_KEY_SECRET=rzp_secret_placeholder_key
ENABLE_DEMO_PAYMENT=true

# Cloudinary Configuration (Optional: fallback to local / hosted demo URLs when absent)
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret
